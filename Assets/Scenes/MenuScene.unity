  m_text: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u043E\u043B\u043D\u044B\u0439
    \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u0438\u0433\u0440\u044B!\n
    \u0420\u0435\u043A\u043B\u0430\u043C\u0430 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430\n+20% \u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u043E\u043C\u0443
    \u043E\u043F\u044B\u0442\u0443 (\u0432 \u0438\u0433\u0440\u0430\u0445 \u0438
    \u0437\u0430\u0434\u0430\u043D\u0438\u044F\u0445)\n\u0414\u043E\u0441\u0442\u0443\u043F
    \u043A \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0435\n
    \u0421\u043C\u0435\u043D\u0430 \u0434\u0438\u0437\u0430\u0439\u043D\u0430 \u043B\u0438\u0446\u0435\u0432\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043A\u0430\u0440\u0442\n\u0414\u043E\u0441\u0442\u0443\u043F
    \u043A \u0437\u0430\u0434\u0430\u043D\u0438\u044F\u043C \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    4 \u0434\u043D\u044F"
